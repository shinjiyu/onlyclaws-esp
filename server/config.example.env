# OnlyClaws private control plane — copy to /opt/epaper/epaper.env on the VPS.
# Do not commit real secrets.

EPD_SESSION_SECRET=change_me
# Optional legacy shared token — only used to migrate existing devices once.
EPD_DEVICE_TOKEN=change_me
# Empty or * = any account can log in. Comma-list = closed allowlist.
EPD_ALLOWLIST=*
# Orphan devices are assigned to this owner during migration.
EPD_BOOTSTRAP_OWNER=yzy.zhenyu@gmail.com
EPD_DEFAULT_DEVICE_ID=a4cb8fdf8440
EPD_PUBLIC_BASE=https://onlyclaws.world
EPD_DATA_DIR=/opt/epaper/data
# Ed25519 PEM used to sign Lua scripts (default: $EPD_DATA_DIR/script_signing_key.pem).
# The firmware public key is OC_SCRIPT_PUBKEY_HEX in rlcd/include/cloud_config.h.
# Deploy returns 503 until this file exists. See doc/structurizr/SCRIPT-PERSIST.md.
# EPD_SCRIPT_SIGNING_KEY=/opt/epaper/data/script_signing_key.pem
# Account service (POST /api/auth/login + /api/auth/register), called server-side only.
EPD_AUTH_UPSTREAM=
