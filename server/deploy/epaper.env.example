EPD_SESSION_SECRET=change-me-long-random
# Legacy bootstrap token (optional). Prefer per-device tokens via /api/devices/register.
EPD_DEVICE_TOKEN=change-me-device-token
# Who may sign in to the console:
#   * or empty  = any account (open)
#   invite      = admins + applications approved at /apply/ (recommended for public launch)
#   a@x,b@y     = these emails + admins + approved applications
EPD_ALLOWLIST=invite
EPD_BOOTSTRAP_OWNER=yzy.zhenyu@gmail.com
# Reviewers of /apply/ submissions (comma-separated). Empty = EPD_BOOTSTRAP_OWNER.
EPD_ADMINS=
# Where "new application" notices go. Empty = EPD_ADMINS.
EPD_ADMIN_NOTIFY=
# Max applications per client IP per hour.
EPD_APPLY_PER_IP_PER_HOUR=5

# Outgoing mail for application notices.
#   MAIL_BACKEND=agently  QQ Mail Agently (xxx@agent.qq.com): npm i -g @tencent-qqmail/agently-cli,
#                         then `agently-cli auth login` as the service user. 50 mails/day.
#   MAIL_BACKEND=smtp     (default when SMTP_HOST is set) use the SMTP_* settings below.
#   unset + no SMTP_HOST  log only, no email.
MAIL_BACKEND=
# Port 465 = implicit TLS; 587 (or SMTP_STARTTLS=1) = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=OnlyClaws
EPD_DEFAULT_DEVICE_ID=a4cb8fdf8440
EPD_PUBLIC_BASE=https://onlyclaws.world
EPD_DATA_DIR=/opt/epaper/data
# Account service the console signs in against (server-side only, never shown to users).
# Must provide POST /api/auth/login and /api/auth/register taking {email, password}.
EPD_AUTH_UPSTREAM=
# Shared key for the upstream's POST /api/auth/service/set-password; enables password reset.
EPD_AUTH_SERVICE_KEY=
